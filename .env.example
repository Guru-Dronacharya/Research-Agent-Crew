# ==============================================================================
# Research Agent Crew — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider Selection
# ------------------------------------------------------------------------------
# Choose active provider: gemini or groq
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1a. Google Gemini Provider
# ------------------------------------------------------------------------------
# Required when LLM_PROVIDER=gemini (obtained from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 1b. Groq Provider
# ------------------------------------------------------------------------------
# Required when LLM_PROVIDER=groq (obtained from Groq Console: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=
# Structured output mode on Groq: function_calling | json_schema | json_mode
GROQ_STRUCTURED_MODE=function_calling

# ------------------------------------------------------------------------------
# 1c. Per-Role Model Overrides (Optional: defaults to provider global model)
# ------------------------------------------------------------------------------
# Planner, Critic, and Chat can use fast models; Synthesis benefits from higher capacity.
# PLANNER_MODEL=
# SYNTH_MODEL=
# CRITIC_MODEL=
# CHAT_MODEL=

# Per-role max output tokens (Synthesis default is 4096 to prevent length truncation)
PLANNER_MAX_TOKENS=2048
CRITIC_MAX_TOKENS=2048
SYNTH_MAX_TOKENS=4096
CHAT_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# 2. Rate Limiting & Quota Protection (Requests & Tokens)
# ------------------------------------------------------------------------------
# Rate limits (RPM, RPD, TPM, TPD). Set 0 to disable limit.
# Copy values from your provider's console tier:
# Groq Console: Settings -> Limits (inspect RPM, RPD, TPM, TPD for your chosen model)
# Gemini AI Studio: Rate limits tab
LLM_RPM=15
LLM_RPD=1500
LLM_TPM=6000
LLM_TPD=100000

# Daily quota reset boundary mode:
# - pacific_midnight: Midnight PT (matches Google Gemini daily reset)
# - utc_midnight: Midnight UTC (matches Groq daily reset)
# - rolling_24h: Continuous sliding 24-hour window
LLM_DAY_RESET=pacific_midnight

# Optional path to a JSON file mapping per-model rate limits:
# LLM_LIMITS_FILE=data/limits.json

# Tool search limiter
SEARCH_RPM=30

# ------------------------------------------------------------------------------
# 3. Execution Concurrency & Parallelism
# ------------------------------------------------------------------------------
# Maximum number of subtasks executed concurrently via asyncio bounded semaphore
EXECUTOR_CONCURRENCY=3

# ------------------------------------------------------------------------------
# 4. Search Providers & DuckDuckGo Engine Selection
# ------------------------------------------------------------------------------
# Priority: Tavily (if set) -> Brave (if set) -> DuckDuckGo (DDGS)
# When an API key provider succeeds, DDGS is never called.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Restrict DDGS engine fanout to a fast, reliable minimal subset (avoids 429/202 delays).
# Available engines: duckduckgo, wikipedia, mojeek, brave, startpage, yahoo, grokipedia
DDGS_BACKENDS=duckduckgo,wikipedia
DDGS_TIMEOUT_SEC=6.0

# ------------------------------------------------------------------------------
# 5. Persistent Search Caching (SQLite)
# ------------------------------------------------------------------------------
# Caches normalized queries (lowercase, stop-word stripped, token sorted) + max_results + provider.
# Cache hits do NOT consume search budget. Error/timeout results are never cached.
CACHE_ENABLED=true
CACHE_DB_PATH=.cache/search.db
CACHE_TTL_SECONDS=21600

# ------------------------------------------------------------------------------
# 6. Synthesis & Context Optimization
# ------------------------------------------------------------------------------
# Max sources per subtask passed to parallel synthesis and critic judge
SYNTH_MAX_SOURCES_PER_SUBTASK=4
SYNTH_SNIPPET_MAX_CHARS=300

# ------------------------------------------------------------------------------
# 7. Workflow & Budget Defaults
# ------------------------------------------------------------------------------
MAX_RETRIES=1
SEARCH_BUDGET=10
INITIAL_BUDGET_FRACTION=0.6
MCP_TOOL_TIMEOUT_SEC=15.0

# ------------------------------------------------------------------------------
# 8. Threads, Resumable Runs & Database Persistence
# ------------------------------------------------------------------------------
# SQLite database path for persistent threads, messages, runs, and run_events:
DATABASE_PATH=data/app.db

# SQLite checkpointer path for LangGraph node-level state checkpoints:
CHECKPOINT_DB_PATH=data/checkpoints.db

# Heartbeat staleness threshold in seconds for orphaned run recovery (default 60s):
# Running runs with a heartbeat older than this at startup are marked failed/"interrupted"
HEARTBEAT_STALE_SECONDS=60

# Allowed CORS origins for REST API (comma-separated, no wildcard with credentials):
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Optional API key for REST API authentication (checked via constant-time comparison):
API_KEY=

# ------------------------------------------------------------------------------
# 9. RAG Ingestion & Vector Retrieval
# ------------------------------------------------------------------------------
# Local embedding model (ONNX via fastembed). Download explicitly before runs: python -m core.rag.download_model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models

# Use fake deterministic embedder for offline unit tests (1 or 0):
USE_FAKE_EMBEDDER=0

# RAG context length and retrieval thresholds
RAG_MAX_CONTEXT_CHARS=24000
# Minimum raw cosine similarity threshold required for retrieved RAG chunks (0.0 to 1.0).
# Run python scripts/calibrate_scores.py to inspect score distributions and calibrate this value.
RAG_MIN_SCORE=0.55
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_THREAD=5000

# Web fetch safety & caps
FETCH_BUDGET=10
FETCH_TIMEOUT_SECONDS=10.0
MAX_FETCH_BYTES=2097152

# Upload limits
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=200
PARSING_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 10. Thread Chat & Intelligent Query Router
# ------------------------------------------------------------------------------
# Maximum context character budget for chat retrieval context:
CHAT_MAX_CONTEXT_CHARS=8000

# Number of past conversation turns (user/assistant pairs) to preserve in context:
CHAT_HISTORY_TURNS=6

# Minimum raw cosine similarity threshold required for thread grounding (0.0 to 1.0).
# Run python scripts/calibrate_scores.py to inspect score distributions and calibrate this value.
CHAT_MIN_SCORE=0.55

# Search budget for quick factual path (number of web searches, 1 default):
QUICK_SEARCH_BUDGET=1

# Query rewrite toggle (0 = zero extra LLM calls, deterministic heuristics):
QUERY_REWRITE=0
